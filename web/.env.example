# Live site only: lets search engines index the site. Leave unset on test environments.
SITE_INDEXABLE=
# Live site only. The business's new GA4 property (opened Nov 2026): G-NF4VXPWTJS
# The old property G-DP3J4RGCV8 belongs to an account nobody can reach; do not carry it over.
NEXT_PUBLIC_GA_ID=
# Lead forms: sent by email through the business's Google Workspace mailbox.
# On the old site every form went to office@sun-power.co.il and a second business inbox,
# subject "ליד חדש מהאתר - דף <page>".
SMTP_USER=
# An app password created for that mailbox (Google account > Security > App passwords).
# Set it only in the hosting dashboard, never in a file that is committed.
SMTP_PASSWORD=
# Recipients, comma separated. Defaults to SMTP_USER.
LEAD_TO=
# Optional: also post each lead to a webhook (future CRM).
LEAD_WEBHOOK_URL=
